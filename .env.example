# Copie para .env e ajuste. O .env NAO vai para o git.

# Chave de assinatura dos cookies de sessao.
# Gere a sua com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave-antes-de-usar

# Banco de dados. SQLite local; no deploy, troque por postgresql+psycopg://...
DATABASE_URL=sqlite:///data/app.db

# Pastas de dados (ficam fora do versionamento)
DATA_DIR=data
UPLOAD_DIR=data/uploads
PROVAS_DIR=data/provas
CACHE_QUESTOES_DIR=data/cache_questoes
SAIDA_DIR=data/saida

# Pastas de origem, fora do repositorio publico
PLANILHA_DIR=planilha_dados
RELATORIOS_REFERENCIA_DIR=exemplos_relatórios
PROVAS_ORIGEM_DIR=exemplos_pdf_provas

# Regras de negocio (decididas com a coordenacao)
CORTE_MATERIA=4.0
CORTE_GERAL=5.0
CORTE_ITA=5.83
BASE_RANKING_POLIEDRO=850

# Ambiente: development | production
ENV=development
